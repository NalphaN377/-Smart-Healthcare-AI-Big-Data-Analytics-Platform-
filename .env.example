# 复制为 .env 后填写本机配置；.env 已被 .gitignore 忽略。

# SQL Server
DB_BACKEND=pymssql
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=replace_with_local_password
DB_NAME=yiliaoBigData
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true
DB_TIMEOUT=10
DB_QUERY_TIMEOUT=60

# 数据导入
SOURCE_DATA_PATH=E:/dev/Hwadee/data/raw/Hospital_Inpatient_Discharges__SPARCS_De-Identified___2021_20231012.csv
CHUNK_SIZE=50000
BATCH_SIZE=5000

# DeepSeek Anthropic 兼容 API
LLM_PROVIDER=deepseek_anthropic
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace_with_your_api_key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT=25

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# 二期功能开关（当前仅预留）
FEATURE_LLM_INTENT=false
FEATURE_REDIS_CACHE=false
FEATURE_ML_ANALYSIS=false
DISTRIBUTED_ENGINE=pandas
FEATURE_LOCAL_LLM=false
