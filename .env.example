# Copy to .env. Never commit the real file.
MYSQL_DATABASE=medical_platform
MYSQL_USER=medical_user
MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30

# Optional Phase 3 Redis cache/session backend. The app degrades safely when disabled/unavailable.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=300
REDIS_SESSION_TTL=86400

FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 2B AI provider. Leave LLM_API_KEY/LLM_MODEL empty to keep AI disabled safely.
AI_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_MODEL=
# Optional endpoint for Qwen or another OpenAI-compatible provider.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# DeepSeek V4 defaults to thinking; Phase 2B acceptance uses non-thinking mode.
LLM_THINKING_MODE=disabled
AI_MAX_TURNS=10
AI_MAX_SESSIONS=500

# Optional Phase 3 ML artifact locations. Defaults resolve relative to the repository.
ML_MODEL_PATH=backend/ml/artifacts/cost_model.joblib
ML_METADATA_PATH=backend/ml/model_metadata.json
