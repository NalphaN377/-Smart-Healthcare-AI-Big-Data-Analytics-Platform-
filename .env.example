# 复制为 .env 后填写本机配置；.env 已被 .gitignore 忽略。

# SQL Server
DB_BACKEND=pymssql
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=replace_with_local_password
DB_NAME=yiliaoBigData
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true
DB_TIMEOUT=10
DB_QUERY_TIMEOUT=60

# 数据导入
SOURCE_DATA_PATH=D:/hwadee_project_workspace/data/Hospital_Inpatient_Discharges__SPARCS_De-Identified___2021_20231012.csv
CHUNK_SIZE=50000
BATCH_SIZE=5000

# DeepSeek Anthropic 兼容 API
LLM_PROVIDER=deepseek_anthropic
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace_with_your_api_key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT=25

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# 登录与 Session（生产环境必须使用随机长密钥并开启 HTTPS Cookie）
SECRET_KEY=replace_with_at_least_32_random_characters
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
SESSION_IDLE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Redis（Redis 数据库为数字编号；项目名通过键前缀隔离）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=yiliaoBigData
REDIS_DEFAULT_TTL=300
REDIS_SOCKET_TIMEOUT=1.5

# 二期功能开关
FEATURE_LLM_INTENT=true
FEATURE_REDIS_CACHE=true
FEATURE_ML_ANALYSIS=false
DISTRIBUTED_ENGINE=pandas
FEATURE_LOCAL_LLM=false
