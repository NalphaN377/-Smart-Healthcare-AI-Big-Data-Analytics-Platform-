digraph SmartHealthcareDataFlow {
  graph [
    rankdir=TB,
    bgcolor="#FFFFFF",
    pad="0.42",
    nodesep="0.46",
    ranksep="0.58 equally",
    splines=ortho,
    newrank=true,
    fontname="Microsoft YaHei",
    fontsize=22,
    fontcolor="#16324F",
    label="智慧医疗大数据与 AI 大模型分析平台——数据流图\n ",
    labelloc=t
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Microsoft YaHei",
    fontsize=12,
    fontcolor="#17324D",
    color="#AFC4D7",
    penwidth=1.4,
    width=6.6,
    height=0.78,
    margin="0.24,0.14"
  ];
  edge [
    fontname="Microsoft YaHei",
    fontsize=9.5,
    color="#6886A0",
    fontcolor="#47677F",
    penwidth=1.45,
    arrowsize=0.75
  ];

  source [
    label="原始数据\nSPARCS 2021 脱敏出院 CSV（33 字段）",
    shape=folder,
    fillcolor="#F8FAFC",
    color="#94A3B8"
  ];

  ingest [
    label="1  数据接入与治理\n批量读取 · 清洗 · 类型转换 · 去重 · 质量评估",
    fillcolor="#ECFDF5",
    color="#34D399"
  ];

  database [
    label="2  SQL Server 数据存储\n暂存表 · 住院事实表 · 导入审计表",
    shape=cylinder,
    fillcolor="#FFF7ED",
    color="#FB923C"
  ];

  analysis [
    label="3  多维分析与 API 服务\n聚合查询 · 指标计算 · 统一 JSON",
    fillcolor="#EFF6FF",
    color="#60A5FA"
  ];

  ai [
    label="4  AI 智能分析编排\n意图识别 · 摘要生成 · 图表配置",
    fillcolor="#F5F3FF",
    color="#A78BFA"
  ];

  view [
    label="5  可视化与报告呈现\nVue 3 · ECharts · SSE 问答 · Markdown 报告",
    fillcolor="#FFF7ED",
    color="#FB923C"
  ];

  user [
    label="业务输出\n运营大屏 · 动态图表 · 文字洞察",
    fillcolor="#E8F2FA",
    color="#38BDF8"
  ];

  admin [
    label="数据管理员",
    fillcolor="#E0F2FE",
    color="#38BDF8",
    width=2.1,
    height=0.62,
    fontsize=10.5
  ];

  llm [
    label="DeepSeek\n模型服务",
    fillcolor="#FFF7ED",
    color="#FDBA74",
    width=2.1,
    height=0.66,
    fontsize=10.5
  ];

  source -> ingest [label="原始记录"];
  ingest -> database [label="清洗后数据"];
  database -> analysis [label="查询数据"];
  analysis -> ai [label="聚合结果"];
  ai -> view [label="摘要与图表配置"];
  view -> user [label="展示"];

  { rank=same; admin; ingest; }
  admin -> ingest [label="导入配置", constraint=false];

  { rank=same; ai; llm; }
  ai -> llm [dir=both, label="模型调用", constraint=false, color="#D09A58"];
}
